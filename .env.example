# App
APP_TITLE=AP Travel & Temple — Module 15: Search APIs
APP_VERSION=1.0.0
DEBUG=False

# Elasticsearch (no auth)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_MAX_RETRIES=5
ELASTICSEARCH_RETRY_DELAY=3

# Redis
REDIS_URL=redis://localhost:6379
REDIS_SUGGESTIONS_TTL=300
REDIS_RECENT_SEARCHES_TTL=604800
REDIS_RECENT_SEARCHES_MAX=10

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ap_travel

# JWT (must match Module 1 Auth)
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256